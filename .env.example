# Kaggle API Credentials (for dataset download)
# Place your kaggle.json in ~/.kaggle/kaggle.json or specify here:
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key

# TRIAD Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Vector C LLM Agent Configuration (Optional - offline fallback is active by default)
# Provide one of the following keys if you want MockShoppingAgent to make live LLM calls:
OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=gpt-4o-mini
